Cell[CellGroupData[{
Cell["Clearing the variables", "Section",
 CellChangeTimes->{{3.96668342096975*^9, 
  3.9666834460572863`*^9}},ExpressionUUID->"1dcddfc8-24bd-4045-835f-\
d9ab0570e036"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "B", ",", "Bx", ",", "Bz", ",", "n", ",", "nx", ",", "nz", ",", "kx", ",", 
    "phi0Z"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.966683448617177*^9, 3.966683521950245*^9}, {
  3.96668778413916*^9, 3.966687784311734*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"62684fb0-fae5-41a1-baed-5ad6e7ab0e62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"Bx", "^", "2"}], "+", 
     RowBox[{"Bz", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nx", "=", 
   RowBox[{"Bx", "/", "B"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nz", "=", 
   RowBox[{"Bz", "/", "B"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi0Z", "=", 
   RowBox[{"ArcTan", "[", 
    RowBox[{"nz", "*", 
     RowBox[{"Tan", "[", "B", "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.966683510086914*^9, {3.9666878081486177`*^9, 3.966687808361208*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"d9ede40e-eb55-4ad9-9d66-2f089aee90d9"]
}, Open  ]],

Cell["\<\
QEC with field acting on N out of (N+1) qubits on a single probe (\
\[OpenCurlyDoubleQuote]ancilla-assisted single-probe\[CloseCurlyDoubleQuote])\
\
\>", "Section",
 CellChangeTimes->{{3.966700520498255*^9, 
  3.9667005655701838`*^9}},ExpressionUUID->"b0c3f537-7d83-42b5-8d2c-\
e111786b1820"],

Cell[CellGroupData[{

Cell["\<\
QEC with field acting on all N qubits on a single probe (\
\[OpenCurlyDoubleQuote]ancilla-free single-probe\[CloseCurlyDoubleQuote])\
\>", "Section",
 CellChangeTimes->{{3.9666832212242327`*^9, 3.966683260768457*^9}, {
   3.966687498964137*^9, 3.966687513019847*^9}, {3.966700532810101*^9, 
