Cell[BoxData[{
 RowBox[{
  RowBox[{"ABZ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "B", "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nz", "*", 
           RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", "2"}]}], ")"}], "^", 
      "kx"}], " ", "*", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"nx", "*", 
        RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "n"}], "-", 
        RowBox[{"2", "*", "kx"}]}], ")"}]}], "*", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", "*", "kx", "*", "phi0Z"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "B", "]"}], "^", "2"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"nz", "*", 
           RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", "2"}]}], ")"}], "^", 
      
      RowBox[{"(", 
       RowBox[{"n", "-", "kx"}], ")"}]}], " ", "*", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"nx", "*", 
        RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"2", "*", "kx"}], ")"}]}], "*", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"n", "-", "kx"}], ")"}], "*", "phi0Z"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pplusQECfullZ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"(", 
       RowBox[{"ABZ", "/", "pkQECfullZ"}], ")"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pminusQECfullZ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"(", 
       RowBox[{"ABZ", "/", "pkQECfullZ"}], ")"}]}], ")"}]}]}], 
  ";"}]}], "Input",
