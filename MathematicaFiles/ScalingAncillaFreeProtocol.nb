Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"nmin", " ", 
    RowBox[{"(", "nmax", ")"}], " ", "is", " ", "the", " ", "smallest", " ", 
    RowBox[{"(", "largest", ")"}], " ", "value", " ", "of", " ", "N", " ", 
    RowBox[{"(", 
     RowBox[{"number", " ", "of", " ", "spins"}], ")"}], " ", "that", " ", 
    "we", " ", "consider"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nmin", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nmax", "=", "21"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"minB", " ", 
     RowBox[{"(", "maxB", ")"}], " ", "is", " ", "the", " ", "smallest", " ", 
     
     RowBox[{"(", "largest", ")"}], " ", "value", " ", "of", " ", "B", " ", 
     RowBox[{"(", 
      RowBox[{"the", " ", "magnetic", " ", "field"}], ")"}], " ", "that", " ",
      "we", " ", "consider"}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minB", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxB", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "  ", 
    RowBox[{"stepB", ":", " ", 
     RowBox[{
     "the", " ", "difference", " ", "between", " ", "each", " ", "contiguous",
       " ", "B", " ", "values"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stepB", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DetListTotalBeff", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"list", " ", "of", " ", 
     RowBox[{"Det", "[", "F", "]"}], " ", "for", " ", "every", " ", 
     "magnetic", " ", "field", " ", "vector"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TraceListTotalBeff", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"list", " ", "of", " ", 
     RowBox[{"Trace", "[", 
      RowBox[{"F", "^", 
       RowBox[{"{", 
        RowBox[{"-", "1"}], "}"}]}], "]"}], " ", "for", " ", "every", " ", 
     "magnetic", " ", "field", " ", "vector"}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "classify", " ", "each", " ", "magnetic", " ", "field", " ", 
     "vector", " ", "in", " ", "4", " ", "possible", " ", 
     RowBox[{"sets", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IndetPointsBeff", "=", 
     RowBox[{"{", "}"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "magnetic", " ", "field", " ", "vectors", " ", "for", " ", "which", " ", 
     "F", " ", "has", " ", "Infinite", " ", "or", " ", "Indeterminate", " ", 
     "entries"}], " ", "*)"}], "\[IndentingNewLine]", 
