   3.9667005712830677`*^9},ExpressionUUID->"58b1d102-7863-44d3-bca5-\
c4117adbd434"],

Cell[CellGroupData[{

Cell["Only stabilizer outcomes", "Subsection",
 CellChangeTimes->{{3.966686479992291*^9, 
  3.966686487136194*^9}},ExpressionUUID->"e3ec5d3d-8826-44b2-83af-\
d5c4ab7be0bf"],

Cell[TextData[{
 "As you can see below, if we only consider the stabilizer outcomes, for all \
magnetic fields the CFI matrices are singular.  You can check that ",
 StyleBox["ALL the determinants are 0",
  FontWeight->"Bold"],
 ", even for small N. "
}], "Text",
 CellChangeTimes->{{3.96668747377139*^9, 3.966687554765872*^9}, {
  3.9666888384029417`*^9, 
  3.966688892331709*^9}},ExpressionUUID->"9b947c7f-7881-44fd-b20d-\
b6248652c527"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pkQECfullZ", "=", 
   RowBox[{
    RowBox[{"Binomial", "[", 
     RowBox[{"n", ",", "kx"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "B", "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nz", "*", 
             RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", "2"}]}], ")"}], 
        "^", 
        RowBox[{"(", 
         RowBox[{"n", "-", "kx"}], ")"}]}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"nx", "*", 
          RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", "*", "kx"}], ")"}]}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "B", "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nz", "*", 
             RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", "2"}]}], ")"}], 
        "^", "kx"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"nx", "*", 
          RowBox[{"Sin", "[", "B", "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{"n", "-", "kx"}], ")"}]}], ")"}]}]}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.966683280313753*^9, 3.966683294945418*^9}, {
  3.966683556373452*^9, 3.966683557445095*^9}},
 CellLabel->
  "In[159]:=",ExpressionUUID->"736918df-ebe8-456a-9356-4c87364d5444"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"minB", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxB", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stepB", "=", "0.05"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nmin", " ", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nmax", "=", "21"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DetListTotal", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "First", " ", "for", " ", "loop", " ", "over", " ", "all", " ", "magnetic",
     " ", "fields", " ", "in", " ", "a", " ", "square", " ", "region", " ", 
    "between", " ", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0"}], ")"}], " ", "and", " ", 
    RowBox[{"(", 
     RowBox[{"1", ",", "1"}], ")"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"Bxaux", "=", 
     RowBox[{"minB", "+", "stepB"}]}], ",", 
    RowBox[{"Bxaux", "<=", 
     RowBox[{"maxB", "-", "stepB"}]}], ",", 
    RowBox[{"Bxaux", "+=", "stepB"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"Bzaux", "=", 
        RowBox[{"minB", "+", "stepB"}]}], ",", 
       RowBox[{"Bzaux", "<=", 
        RowBox[{"maxB", "-", "stepB"}]}], ",", 
       RowBox[{"Bzaux", "+=", "stepB"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"DetListLocal", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Second", " ", "for", " ", "loop", " ", "over", " ", "several", " ", 
          "values", " ", "of", " ", "N", " ", 
          RowBox[{"(", 
           RowBox[{"number", " ", "of", " ", "qubits"}], ")"}]}], " ", "*)"}],
         "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"naux", "=", "nmin"}], ",", 
          RowBox[{"naux", "<=", "nmax"}], ",", 
          RowBox[{"naux", "+=", "2"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"FoutcomesQECxxZ", "=", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "pkQECfullZ"}], ")"}], "*", 
                 RowBox[{"D", "[", 
                  RowBox[{"pkQECfullZ", ",", "Bx"}], "]"}], "*", 
                 RowBox[{"D", "[", 
                  RowBox[{"pkQECfullZ", ",", "Bx"}], "]"}]}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"n", "->", "naux"}], ",", 
                 RowBox[{"Bx", "->", 
                  RowBox[{"Bxaux", "*", "Pi"}]}], ",", 
                 RowBox[{"Bz", "->", 
                  RowBox[{"Bzaux", "*", "Pi"}]}]}], "}"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"kx", ",", "0", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"naux", "-", "1"}], ")"}], "/", "2"}]}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"FoutcomesQECzzZ", "=", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "pkQECfullZ"}], ")"}], "*", 
                 RowBox[{"D", "[", 
                  RowBox[{"pkQECfullZ", ",", "Bz"}], "]"}], "*", 
                 RowBox[{"D", "[", 
                  RowBox[{"pkQECfullZ", ",", "Bz"}], "]"}]}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"n", "->", "naux"}], ",", 
                 RowBox[{"Bx", "->", 
                  RowBox[{"Bxaux", "*", "Pi"}]}], ",", 
                 RowBox[{"Bz", "->", 
                  RowBox[{"Bzaux", "*", "Pi"}]}]}], "}"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"kx", ",", "0", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"naux", "-", "1"}], ")"}], "/", "2"}]}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"FoutcomesQECxzZ", "=", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "pkQECfullZ"}], ")"}], "*", 
                 RowBox[{"D", "[", 
                  RowBox[{"pkQECfullZ", ",", "Bx"}], "]"}], "*", 
                 RowBox[{"D", "[", 
                  RowBox[{"pkQECfullZ", ",", "Bz"}], "]"}]}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"n", "->", "naux"}], ",", 
                 RowBox[{"Bx", "->", 
                  RowBox[{"Bxaux", "*", "Pi"}]}], ",", 
                 RowBox[{"Bz", "->", 
                  RowBox[{"Bzaux", "*", "Pi"}]}]}], "}"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"kx", ",", "0", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"naux", "-", "1"}], ")"}], "/", "2"}]}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"FoutcomesQECZ", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"FoutcomesQECxxZ", ",", "FoutcomesQECxzZ"}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"FoutcomesQECxzZ", ",", "FoutcomesQECzzZ"}], "}"}]}], 
             "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"DetListLocal", ",", 
             RowBox[{"Det", "[", "FoutcomesQECZ", "]"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"DetListTotal", ",", 
          RowBox[{"{", 
           RowBox[{"Bxaux", ",", "Bzaux", ",", "DetListLocal"}], "}"}]}], 
         "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.966686073983629*^9, 3.9666862246485023`*^9}, {
   3.966686271192769*^9, 3.966686331441908*^9}, {3.9666864065716867`*^9, 
